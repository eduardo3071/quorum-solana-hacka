# Copie para .env e preencha. O .env nunca é commitado.

# Supabase — as duas são públicas por natureza, protegidas por RLS.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>

# A API que assina no cofre. NÃO é o endereço desta interface — os dois têm
# nome parecido e trocá-los faz toda chamada do cofre receber HTML em vez de
# JSON:
#
#   solana-hacka-university.lovable.app   ← a interface (este projeto)
#   solana-hacka-university.vercel.app    ← a API (o app Next)
#
# Deixe em branco: o padrão do código já é o endereço certo. Só preencha se a
# API mudar de domínio.
# VITE_API_URL=https://solana-hacka-university.vercel.app

# NUNCA ponha a service_role aqui. Ela ignora toda política de acesso, e no
# navegador seria o banco inteiro aberto.
